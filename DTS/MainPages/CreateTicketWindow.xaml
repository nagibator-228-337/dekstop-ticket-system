<Window x:Class="DTS.CreateTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Ticket"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        MinWidth="650"
        MinHeight="450"
        MaxWidth="800"
        MaxHeight="700"
        Background="Transparent">

    <Grid>
        <Border CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                MinWidth="650"
                MinHeight="450">

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Create Ticket"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}"/>

                <Grid Grid.Row="2" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Subject*" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox Name="SubjectTextBox" Style="{StaticResource BaseTextBox}" MaxLength="30"/>
                        <TextBlock Name="SubjectUnfilledBlock"
                                   Text="Please fill in this field"
                                   Foreground="Red"
                                   Visibility="Collapsed"
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Your contact email" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox Name="ContactTextBox" Style="{StaticResource BaseTextBox}" MaxLength="60"/>
                        <TextBlock Name="WrongContactFormat"
                                   Text="This Email Incorrect"
                                   Foreground="Red"
                                   Visibility="Collapsed"
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="Description* (0/800)"
                                   Style="{StaticResource SubtitleText}"
                                   Margin="0,0,0,4"
                                   Name="DescriptionCounterTextBlock"/>
                        <TextBox Name="DescriptionTextBox"
                                 Style="{StaticResource BaseTextBox}"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 Height="200"
                                 MaxLength="800"
                                 TextChanged="DescriptionTextBox_TextChanged"/>
                        <TextBlock Name="DescriptionUnfilledBlock"
                                   Text="Please fill in this field"
                                   Foreground="Red"
                                   Visibility="Collapsed"
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <Button Grid.Row="6"
                            Name="CreateButton"
                            Content="Create Ticket"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right"
                            Width="160"
                            Height="48"
                            Click="CreateButton_click"/>
                </Grid>

                
            </Grid>
            
        </Border>
        
        <!-- Code part-->
        <Grid Name="CodeGrid" Visibility="Collapsed">
            <Border Background="#80000000"
            CornerRadius="12"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    Width="400"
                    Height="180"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Ticket Code"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}"/>

                    <StackPanel Grid.Row="2" Margin="0,8" HorizontalAlignment="Center">
                        <TextBlock Text="Here is your ticket code. Keep it safe for later access."
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
                        <TextBox Name="CodeTextBlock"
                             Width="260"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             TextAlignment="Center"
                             Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        <Button Content="Copy"
                                Width="80"
                                Margin="4,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="CopyCode_Click"/>
                        <Button Content="Close"
                                Width="80"
                                Margin="4,0"
                                Style="{StaticResource ErrorButton}"
                                Click="CloseCodeOverlay_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
