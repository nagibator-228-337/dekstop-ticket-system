<Window x:Class="DTS.MainPages.TicketView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket"
        Height="350"
        Width="650">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- CHAT -->
        <Border Grid.Column="1"
                Margin="5"
                BorderBrush="Gray"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChatHeader"
                           FontWeight="Bold"
                           Margin="10"
                           HorizontalAlignment="Center"/>

                <Border Grid.Row="1"
                        Margin="10"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Background="#F9F9F9"/>

                <Grid Grid.Row="2" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="30"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

                    <Button Grid.Column="1"
                            Content="Send"
                            Margin="5,0,0,0"
                            Padding="10,5"/>
                </Grid>
            </Grid>
        </Border>

        <!-- CLIENT VIEW -->
        <Grid Grid.Column="0"
              x:Name="ForClient"
              Visibility="Collapsed"
              Margin="5,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     Text="{Binding Subject}"
                     IsReadOnly="True"
                     Margin="0,0,0,5"/>

            <TextBox Grid.Row="1"
                     Text="{Binding Description}"
                     IsReadOnly="True"/>
        </Grid>

        <!-- EMPLOYEE VIEW -->
        <Grid Grid.Column="0"
              x:Name="ForEmployee"
              Visibility="Visible"
              Margin="5,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Assign employee -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,5">

                <TextBlock Text="Assign employee: Currently —"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="EmployeeComboBox"
                          Width="140"
                          Margin="5,0"
                          DataContext="{x:Null}"
                          DisplayMemberPath="FullName"/>

                <Button Content="Pin"
                        Width="50"
                        Height="22"
                        Click="PinButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,0,5">

                <TextBlock Text="Status: "
                           VerticalAlignment="Center"/>

                <ComboBox Name="StatusComboBox"
                          Width="140"
                          Margin="5,0"/>    
            </StackPanel>

            <TextBox Grid.Row="2"
                     Text="{Binding ClientContact}"
                     IsReadOnly="True"
                     Margin="0,0,0,5"/>

            <TextBox Grid.Row="3"
                     Text="{Binding Subject}"
                     IsReadOnly="True"
                     Margin="0,0,0,5"/>

            <TextBox Grid.Row="4"
                     Text="{Binding Description}"
                     IsReadOnly="True"/>
        </Grid>
    </Grid>
</Window>
