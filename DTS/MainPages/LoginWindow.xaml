<Window x:Class="DTS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="360"
        Height="360"
        Background="{StaticResource BackgroundBrush}">

    <Border CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Login"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}"/>

            <!-- Content -->
            <Grid Grid.Row="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Login -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Login"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,4"/>
                    <TextBox Name="LoginTextBox"
                             Style="{StaticResource BaseTextBox}"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Password"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,0,0,4"/>
                    <PasswordBox Name="PasswordTextBox"
                                 Style="{StaticResource BasePasswordBox}"/>
                </StackPanel>

                <!-- Login button -->
                <Button Grid.Row="4"
                        Name="LoginButton"
                        Content="Login"
                        Style="{StaticResource PrimaryButton}"
                        Height="30"
                        Width="150"
                        HorizontalAlignment="Center"
                        Click="LoginButton_click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
