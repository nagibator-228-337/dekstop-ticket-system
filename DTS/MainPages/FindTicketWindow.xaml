<Window x:Class="DTS.FindTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DTS"
        mc:Ignorable="d"
        Title="FInd a ticket" Height="auto" Width="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Enter your ticket code to find the ticket"
                   Grid.ColumnSpan="2"
                   HorizontalAlignment="Center"
                   />

        <TextBox Name="CodeTextBox"
                 Grid.Row="1"
                />

        <Button Name="FindTicket"
                Grid.Row="1"
                Grid.Column="1"
                Content="Find a ticket"
                />

        <TextBlock Name="CodePlaceholder"
                   Text=" Code here"
                   Grid.Row="1"
                   Style="{StaticResource PlaceholderStyle}"/>

    </Grid>
</Window>
