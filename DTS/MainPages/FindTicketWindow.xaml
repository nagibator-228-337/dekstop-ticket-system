<Window x:Class="DTS.FindTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a Ticket"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="520"
        Height="220"
        Background="Transparent">

    <Border CornerRadius="12"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Back"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Click="BackButton_Click"
                        Grid.Column="1"/>

                <TextBlock Grid.Column="0"
                           Text="Find Ticket"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}"/>

            <Grid Grid.Row="2" Margin="24" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Enter your ticket code to find the ticket"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="CodeTextBox"
                                 Style="{StaticResource BaseTextBox}"/>

                        <TextBlock x:Name="CodePlaceholder"
                                   Text=" Code here"
                                   Style="{StaticResource PlaceholderStyle}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <Button x:Name="FindTicket"
                            Grid.Column="1"
                            Content="Find a Ticket"
                            Style="{StaticResource SecondaryButton}"
                            Width="140"
                            Height="44"
                            Margin="12,0,0,0"
                            Click="FindButton_click"/>
                </Grid>

                <TextBlock x:Name="CodeErrorBlock"
                           Grid.Row="4"
                           Text="Please enter a valid ticket code"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="Collapsed"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
