<Page x:Class="DTS.MainEmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DTS"
      mc:Ignorable="d" 
      Focusable="True"
      FocusManager.IsFocusScope="True"
      KeyboardNavigation.TabNavigation="Cycle"
      d:DesignHeight="450" d:DesignWidth="800"
      Background="White"
      Title="MainEmployeePage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="2">
            <DataGrid Name="TicketsGrid" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      MouseDoubleClick="TicketsGrid_MouseDoubleClick">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto"/>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="Assignee" Binding="{Binding AssignedEmployee}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>


        </Grid>
        <!-- Admin panel (for create new employees) (right now not realized) -->
        <Button Name="AddEmployees"
                Grid.Row="0"
                Content="Add new employee"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Visibility="Collapsed"
                />
    </Grid>
</Page>
